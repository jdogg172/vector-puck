{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vector optional same-host household",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "room",
    "rooms",
    "timezone"
  ],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 2
    },
    "room": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$"
    },
    "rooms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "aliases": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        }
      }
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone, for example UTC or Europe/London"
    }
  }
}
