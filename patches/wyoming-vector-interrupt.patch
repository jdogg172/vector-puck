+static void indicator_style(const char *event, int message, struct ring_light *l)
+{
+    struct json j = {0};
+    int data = event_data(&j, event);
+    l->brightness = .8f;
+    if (message) l->r = l->g = l->b = 1;   /* unknown or missing color: white */
+    if (data >= 0) {
+        int pct = json_get(&j, data, "brightness_pct");
+        if (json_type(&j, pct) == J_NUM) {
+            const struct jtok *t = &j.t[pct];
+            long long value = json_int(&j, pct, 0);
+            if (value >= 20 && value <= 100 && strspn(j.s + t->start, "0123456789") == (size_t)(t->end - t->start))
+                l->brightness = (float)value / 100;
+        }
+        if (message) {
+            int c = json_get(&j, data, "color");
+            if (json_streq(&j, c, "cyan")) l->r = 0;
+            else if (json_streq(&j, c, "green")) l->r = l->b = 0;
+            else if (json_streq(&j, c, "violet")) { l->r = .5f; l->g = 0; }
+            else if (json_streq(&j, c, "amber")) { l->g = .75f; l->b = 0; }
+        }
+    }
+    json_free(&j);
