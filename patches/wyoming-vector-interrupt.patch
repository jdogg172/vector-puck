     else { led("-u", "mics-off_on"); led("-s", "mics-off_end"); }
     if (connected && proto->mute_changed) proto->mute_changed(now);
 }
@@ -2164,6 +2168,13 @@ static void *playback_thread(void *arg)
             atomic_store(&tts_on, 0); playback_hint();
             pthread_mutex_lock(&core_lock);
             atomic_store(&flush_playback, 0);       /* under the lock: a wake word between would cut the next reply */
+            /* This is our reply's stop-only mic stream, not a new user request.
+             * End it without a cancellation event that would erase the next follow-up. */
+            if (proto == &proto_wyoming && wake_wait) {
+                wake_wait = 0;
+                atomic_store(&streaming, 0);
+                mic_stopped();
+            }
             if (proto->played) proto->played();      /* also without a client: modules reset their state here */
             if (wake_cut) wake_cut = 0;              /* cut for Home Assistant's wake word: its run is the request (core_remote_wake) */
             else core_pipeline_finish();
@@ -2195,6 +2206,23 @@ void core_tts_abandoned(void) { wake_cut = 0; }
 int  core_tts_flushing(void) { return atomic_load(&flush_playback); }
 void core_tts_flush(void) { atomic_store(&flush_playback, 1); }
 
+void core_vector_stop(void)
+{
+    if (proto != &proto_wyoming || (state != SPEAKING && state != THINKING)) return;
+    atomic_store(&flush_playback, 1);
+    atomic_store(&streaming, 0);
+    mic_stopped();
+    barge_in = 0; wake_wait = 0; wake_cut = 0;
+    if (connected && proto->cancel) proto->cancel();
+    /* Discard the queued long answer, including its old Q_STOP. One fresh stop
+     * releases playback and restarts wake-only capture; no stale reply can resume. */
+    pthread_mutex_lock(&q_lock);
+    while (q_head) { struct item *old = q_head; q_head = old->next; free(old); }
+    q_tail = NULL; q_bytes = 0;
+    pthread_mutex_unlock(&q_lock);
+    q_push(Q_STOP, 0, 0, 0, NULL, 0);
+}
+
 size_t core_tts_queued(void)
 {
     pthread_mutex_lock(&q_lock); size_t n = q_bytes; pthread_mutex_unlock(&q_lock);
@@ -2686,6 +2714,11 @@ static void on_action(void)
     if (dropin_running() && dropin_button()) return;    /* a Drop In rang (answered) or ran (ended) */
     pthread_mutex_lock(&core_lock);
     int busy = state == LISTENING || state == THINKING;
+    if (proto == &proto_wyoming && (state == SPEAKING || state == THINKING)) {
+        core_vector_stop();
+        pthread_mutex_unlock(&core_lock);
+        return;
+    }
     pthread_mutex_unlock(&core_lock);
     if (!busy && (a2dp_button(0) || (core_sendspin_port && sendspin_button()) || a2dp_button(1))) return;
     atomic_store(&trigger_pending, 2);                  /* 2: touch */
