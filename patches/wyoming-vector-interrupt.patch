+static void run_satellite(const char *event)
+{
+    if (core_vector_focus_supported()) {
+        struct json j = {0};
+        int data = event_data(&j, event), token = json_get(&j, data, "vector_ring_offset_deg");
+        int degrees = 181;              /* use the local device setting */
+        if (json_type(&j, token) == J_NUM) {
+            const char *p = j.s + j.t[token].start, *end = j.s + j.t[token].end;
+            long long v = json_int(&j, token, 181);
+            if (*p == '-') ++p;
+            if (v >= -180 && v <= 180 && strspn(p, "0123456789") == (size_t)(end - p)) degrees = (int)v;
+        }
+        json_free(&j);
+        ring_vector_offset(degrees);
+    }
