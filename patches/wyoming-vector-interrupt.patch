@@ -150,6 +150,7 @@ enum { WAKE_AMAZON, WAKE_MWW, WAKE_HA };       /* WAKE_HA: Home Assistant listen
 int  core_wake_engine(int set);
 const char *core_wake_refused(void);             /* lock held: why the last core_wake_engine(set) did not take */
