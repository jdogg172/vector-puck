+/* Wyoming carries data inline in the header or in a separately framed JSON object. */
+static int event_data(struct json *j, const char *event)
+{
+    const char *body = strchr(event, '\n'), *text = body ? body + 1 : event;
+    if (json_parse(j, text, strlen(text))) return -1;
+    return body ? 0 : json_get(j, 0, "data");
