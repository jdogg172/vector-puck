@@ -1071,7 +1071,11 @@ static void mute_update(int was, int sound)   /* lock held: ring, sound + Home A
     int now = core_muted();
     if (now == was) return;
     if (sound) sound_request(now ? SND_MICS_OFF : SND_MICS_ON);
-    if (now) { if (state == LISTENING) core_pipeline_finish(); led("-s", "mics-off_on"); }
+    if (now) {
+        if (proto == &proto_wyoming && (state == SPEAKING || state == THINKING)) core_vector_stop();
